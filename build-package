#!/usr/bin/sh
set -eu

if [ -z "${ANDROID_NDK_HOME:-}" ]; then
    echo "Error: Env Variable ANDROID_NDK_HOME is not set."
    exit 1
fi

if [ -z "${GITHUB_REF_NAME:-}" ] && [ -z "${VERSION:-}" ]; then
    echo "Error: Env Variable GITHUB_REF_NAME or VERSION is not set."
    exit 1
fi

rm -rf blake3-kmp/src/jvmMain/resources/jni
rm -rf blake3-kmp/src/androidMain/jniLibs
rm -rf blake3-kmp/src/androidMain/resources/native-host
rm -rf blake3-ffm/src/main/resources/jni

mkdir -p blake3-kmp/src/jvmMain/resources/jni
mkdir -p blake3-kmp/src/androidMain/jniLibs
mkdir -p blake3-kmp/src/androidMain/resources/native-host
mkdir -p blake3-ffm/src/main/resources/jni

cd blake3-kmp
zig build android -p src/androidMain/jniLibs
zig build jvm -p src/jvmMain/resources/jni
cd ..

cp -R blake3-kmp/src/jvmMain/resources/jni/. blake3-ffm/src/main/resources/jni/
cp -R blake3-kmp/src/jvmMain/resources/jni/aarch64 blake3-kmp/src/androidMain/resources/native-host/
cp -R blake3-kmp/src/jvmMain/resources/jni/amd64 blake3-kmp/src/androidMain/resources/native-host/
# AGP strips *.so from classes.jar resources: keep Linux lib as *.so.bin.
# The loader tries both names; System.load works with any temp-file extension.
find blake3-kmp/src/androidMain/resources/native-host -name "libblake3-kmp.so" -exec sh -c 'mv "$1" "$1.bin"' _ {} \;

find blake3-kmp/src/jvmMain/resources/jni blake3-ffm/src/main/resources/jni blake3-kmp/src/androidMain/resources/native-host -name "*.pdb" -type f -delete
find blake3-kmp/src/jvmMain/resources/jni blake3-ffm/src/main/resources/jni blake3-kmp/src/androidMain/resources/native-host -name "*.lib" -type f -delete

printf '\n===== Android JNI (arm64-v8a, armeabi-v7a, x86_64, x86) =====\n'
ls -lRh blake3-kmp/src/androidMain/jniLibs
printf '\n===== desktop JVM JNI =====\n'
ls -lRh blake3-kmp/src/jvmMain/resources/jni
printf '\n===== android native-host (host-test only, exclude in apps) =====\n'
ls -lRh blake3-kmp/src/androidMain/resources/native-host
printf '\n---------- zig build is done ----------\n'

./gradlew publishToMavenLocal
